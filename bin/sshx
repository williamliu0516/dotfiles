#!/usr/bin/env bash
# 连到别的机器并接进那边的 tmux：sshx 主机 [会话名]；moshx 用法一样，走 mosh。
#   不带会话名：接回对方最近用的会话，没有就新开；带会话名：接进那个会话，没有就用这个名字新开。
#
# 从带刘海的 MacBook（机型在 config/tmux/notch-models 里）的 Ghostty 直接连（不在本地 tmux 里）时，顺带把刘海布局带过去：
# 把 config/tmux/notch.tmux 写到对方的 ~/.cache/tmux-notch.tmux，接入后加载它，并把这次接入的
# tmux 客户端 pid 登记进 @notch-clients。对方的状态栏是每个客户端各算各的，所以只有这个客户端让出刘海，
# 对方自己的屏幕、iPad 等其他客户端照常。对方不用装这套 dotfiles，但 tmux 要够新（3.8 可以，3.4 不行，见 notch.tmux）。
# 在别的电脑上、或者已经在本地 tmux 里时，只是普通地连上去接 tmux。
#
# 环境变量 SSHX_SOCKET=名字：接对方 tmux -L 名字 的 server（测试用）。
set -euo pipefail

me=$(basename "$0")
mode=ssh; [ "$me" = moshx ] && mode=mosh
if [ $# -lt 1 ] || [ $# -gt 2 ]; then
  echo "用法: $me 主机 [会话名]" >&2; exit 2
fi
host=$1 session=${2:-}

notch=0 px=""
dots=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
conf="$dots/config/tmux/notch.tmux"
if [ -z "${TMUX:-}" ] && [[ "${TERM:-}" == *ghostty* ]] && [ -r "$conf" ] \
   && px=$("$dots/bin/tmux/notch-model.sh"); then
  notch=1
fi

b64() { base64 | tr -d '\n'; }
# 参数都转成 base64（空值用 -），这样经过对方登录 shell 和 sh -c 两层也不用操心引号
arg() { if [ -n "$1" ]; then printf %s "$1" | b64; else printf -; fi; }

# 对方执行的 POSIX sh：$1 会话名 $2 notch.tmux 内容 $3 tmux socket 名 $4 刘海像素，都是 base64 或 -
remote_script=$(cat <<'EOF'
d() { [ "$1" = - ] || printf %s "$1" | base64 -d; }
s=$(d "$1"); k=$(d "$3")
# 对方没有 Ghostty 的 terminfo 时 tmux 起不来（missing or unsuitable terminal）；Ghostty 自己的 ssh 包装
# 只管交互 shell 里敲的 ssh，管不到这里
if command -v infocmp >/dev/null 2>&1 && ! infocmp "${TERM:-dumb}" >/dev/null 2>&1; then export TERM=xterm-256color; fi
if [ "$2" != - ]; then
  f="$HOME/.cache/tmux-notch.tmux"
  mkdir -p "$HOME/.cache"
  d "$2" > "$f.$$" && mv "$f.$$" "$f"
  set -- \; source-file "$f" \; set -g @notch-pixels "$(d "$4")" \; set -gaF @notch-clients " #{client_pid} "
else
  set --
fi
if [ -n "$k" ]; then t="tmux -L $k"; else t=tmux; fi
if [ -n "$s" ]; then exec $t new-session -A -s "$s" "$@"; fi
if $t has-session 2>/dev/null; then exec $t attach-session "$@"; fi
exec $t new-session "$@"
EOF
)

file_arg=-
[ "$notch" = 1 ] && file_arg=$(b64 < "$conf")
args=("$(arg "$session")" "$file_arg" "$(arg "${SSHX_SOCKET:-}")" "$(arg "$px")")
runner="eval \"\$(echo $(printf %s "$remote_script" | b64) | base64 -d)\""

# 套一层 sshx-upload：拖进窗口的本机图片 / 文件、Ctrl+V 时本机剪贴板里的图片，先传到对方的
# ~/Downloads/webmosh/（和 webmosh 同一个目录），再粘贴对方的路径，Claude Code 就能当附图收下
wrap=()
if [ -x "$dots/bin/sshx-upload" ] && command -v python3 >/dev/null 2>&1; then wrap=("$dots/bin/sshx-upload" "$host" --); fi

if [ "$mode" = mosh ]; then
  # mosh 自己会给命令参数加引号
  exec ${wrap[@]+"${wrap[@]}"} mosh "$host" -- sh -c "$runner" sh "${args[@]}"
else
  # ssh 把参数拼成一行交给对方的登录 shell：只有 runner 需要引号，它里面没有单引号
  exec ${wrap[@]+"${wrap[@]}"} ssh -t "$host" "sh -c '$runner' sh ${args[*]}"
fi
