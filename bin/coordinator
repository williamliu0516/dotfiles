#!/bin/sh
# coordinator: open a long-running coordinator Claude Code session by name, starting it in the background
# when none is running. It runs on the default sign-in, not through `we` / `will`, so a quota watcher can
# move it between accounts by switching that sign-in.
# Which session, where it starts and its first prompt are machine-specific and stay out of the repo:
# ~/.config/coordinator/config sets COORD_NAME, COORD_DIR and COORD_PROMPT (shell syntax).
#   coordinator           attach to the running one; else start it in the background, then attach
#   coordinator status    say whether it is running
#   coordinator --print   print the start command and do nothing
CONF="$HOME/.config/coordinator/config"
[ -r "$CONF" ] || { echo "coordinator: $CONF is missing (COORD_NAME, COORD_DIR, COORD_PROMPT)" >&2; exit 2; }
. "$CONF"
NAME=${COORD_NAME:?coordinator: COORD_NAME is not set in $CONF}
TRAIN=${COORD_DIR:?coordinator: COORD_DIR is not set in $CONF}
FIRST=${COORD_PROMPT:-}
# Default sign-in: drop a we / will config dir inherited from the shell (claude-as sets it).
unset CLAUDE_CONFIG_DIR

# In tmux, go through tmux-kgp like the zsh `claude` function, so images still show.
run_claude() {
  if [ -n "${TMUX:-}" ] && [ -t 0 ] && [ -t 1 ] && kgp=$(command -v tmux-kgp); then
    py="$HOME/.local/share/claude-img/claude"
    "$py" -c '' 2>/dev/null || py=python3
    CLAUDE_CODE_FORCE_TERMINAL_IMAGES=1 "$py" "$kgp" claude "$@"
  else
    claude "$@"
  fi
}

# Print the id of the newest live session named $NAME. 0 found, 1 none, 2 the session list could not be read.
# Attach goes by id: stopped sessions keep the name, so `claude attach <name>` stops matching after a restart.
live_id() {
  claude agents --json 2>/dev/null | python3 -c '
import json, sys
try:
    rows = json.load(sys.stdin)
except ValueError:
    sys.exit(2)
live = [r for r in rows if r.get("name") == sys.argv[1] and r.get("state") not in ("stopped", "done", "failed")]
if not live:
    sys.exit(1)
r = max(live, key=lambda r: r.get("startedAt", 0))
if r.get("kind") == "interactive":
    print("coordinator: %s is open in another terminal (pid %s, %s)" % (sys.argv[1], r.get("pid"), r.get("cwd")), file=sys.stderr)
    sys.exit(3)
print(r.get("id") or r["sessionId"][:8])' "$NAME"
}

start() {
  run_claude --bg --settings "$HOME/.claude/direct-settings.json" --model opus --effort high \
    --permission-mode auto -n "$NAME" "$FIRST"
}

case "${1:-}" in
  --print)
    echo "cd $TRAIN && claude --bg --settings ~/.claude/direct-settings.json --model opus --effort high --permission-mode auto -n $NAME '<first prompt>' && claude attach <id>"
    exit 0 ;;
  status)
    id=$(live_id); r=$?
    case $r in 0) echo "$NAME is running ($id)" ;; 1) echo "$NAME is not running" ;; 2) echo "could not read the session list (claude agents --json)" >&2 ;; esac
    exit $r ;;
  "") ;;
  *) echo "usage: coordinator [status | --print]" >&2; exit 2 ;;
esac

id=$(live_id); r=$?
if [ $r = 2 ]; then
  echo "coordinator: could not read the session list (claude agents --json); not starting a second one" >&2
  exit 1
fi
[ $r = 3 ] && exit 1
if [ $r = 1 ]; then
  [ -d "$TRAIN" ] || { echo "coordinator: $TRAIN is missing" >&2; exit 1; }
  cd "$TRAIN" || exit 1
  start || { echo "coordinator: the background start failed" >&2; exit 1; }
  for _ in 1 2 3 4 5; do
    id=$(live_id) && break
    sleep 1
  done
  [ -n "$id" ] || { echo "coordinator: started, but $NAME is not in the session list; try claude agents" >&2; exit 1; }
fi
run_claude attach "$id"
