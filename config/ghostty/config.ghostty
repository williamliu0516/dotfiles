# ===== 主题（朋友自制 snappy，跟随系统明暗）=====
theme = dark:snappy,light:snappy_light

# ===== 字体 =====
font-family = Maple Mono NF CN
font-size = 12
font-thicken = true
font-feature = +cv01
font-feature = +cv02
font-feature = +zero

# 行高 +12%，排版更透气（也更好读）
adjust-cell-height = 12%

# ===== 可读性（我的改动，非他的配置，见说明）=====
minimum-contrast = 1.8
# 暗淡文字（ANSI faint）默认只有 50% 不透明度，抬到 70%
faint-opacity = 0.7

# ===== 光标 =====
cursor-style = bar
cursor-style-blink = false
adjust-cursor-thickness = 2

# ===== 窗口 =====
# 半透明 + 毛玻璃：透出的是真实的桌面，而不是一张贴上去的图。
# 模糊怎么做因系统而异，见 linux.ghostty / macos.ghostty。
# 0.75 时正文在最坏情况（背后是白色窗口）仍有 4.9:1，背后是壁纸时 9.1:1。
# 开销实测：终端持续输出时 gnome-shell 多占约 2–5% 单核；画面静止时按设计不重算（这点没单独测）。
background-opacity = 0.75

window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
# 内边距用背景色填满，不露出接缝
window-padding-color = extend
resize-overlay = never

# ===== 光标拖尾动画（你朋友那个着色器）=====
# 已关闭：着色器要求窗口在前台时持续跑动画循环，实测空闲占 18% 单核 CPU，关掉后为 0%。
# custom-shader-animation = false 也不行：拖尾会停在半路变成残影。要拖尾就得付这份电。
# custom-shader = shaders/cursor_warp.glsl
# custom-shader-animation = true

# ===== 行为 =====
shell-integration-features = no-cursor,no-sudo,title
bell-features = no-system,no-audio,no-attention,no-title,no-border
clipboard-read = allow
clipboard-write = allow
link-url = true
mouse-hide-while-typing = true
copy-on-select = clipboard
scrollback-limit = 100000

# ===== 系统专属设置 =====
# 安装脚本把 linux.ghostty 或 macos.ghostty 软链成 platform.ghostty；? 表示文件不存在也不报错
config-file = ?platform.ghostty
