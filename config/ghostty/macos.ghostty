# macOS 专属设置，由主配置通过 platform.ghostty 引入

# 标题栏藏起来，但保留窗口圆角和阴影（window-decoration = false 在 macOS 上会连这些一起去掉）
macos-titlebar-style = hidden

# 让 Option 当 Alt 用：tmux 的 Alt+m 菜单、Alt+h/j/k/l 切窗格都靠它
macos-option-as-alt = true

# ===== 毛玻璃：静态壁纸图代替实时模糊 =====
# 原生全屏（Cmd+Enter / Ctrl+Cmd+F）会把窗口搬进新 Space，背后是黑的，实时 background-blur 透不出壁纸。
# 之前用 macos-non-native-fullscreen 绕开，代价是不是系统全屏（没有独立 Space、手势切不过去）。
# 现在改成：窗口不透明，背景铺一张预先模糊好的当前壁纸截图（backgrounds/make.sh 生成，不进 git）。
# 全屏和窗口模式看起来一致，也省掉实时模糊的合成开销；代价是窗口模式下不再透出真实的桌面，换壁纸要重跑脚本。
background-opacity = 1
background-image = backgrounds/wallpaper.png
# 图和主题背景色按 0.25 : 0.75 混合，正好等于原来 background-opacity = 0.75 透出模糊桌面的配比；想更"透"就调大。
background-image-opacity = 0.25
background-image-fit = cover
background-image-position = center
# Ctrl+Enter 在 macOS 上默认没绑定，补上，和 Linux 同一个键；Cmd+Enter 仍然可用
keybind = ctrl+enter=toggle_fullscreen

# ===== 把 Option+←/→ 原样交给 tmux =====
# Ghostty 在 macOS 上默认把 Option+←/→ 改写成 Esc b / Esc f（按词移动），
# tmux 收到的是 M-b / M-f 而不是 M-Left / M-Right，Alt+←/→ 切窗口就失效了。
# 解绑后它们和 Linux 一样送出 \e[1;3D / \e[1;3C；tmux 外的按词移动由 zshrc 单独绑这两个序列。
keybind = alt+arrow_left=unbind
keybind = alt+arrow_right=unbind
