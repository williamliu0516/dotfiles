# macOS 专属设置，由主配置通过 platform.ghostty 引入

# 标题栏藏起来，但保留窗口圆角和阴影（window-decoration = false 在 macOS 上会连这些一起去掉）
macos-titlebar-style = hidden

# 让 Option 当 Alt 用：tmux 的 Alt+m 菜单、Alt+h/j/k/l 切窗格都靠它
macos-option-as-alt = true

# 新窗口和全屏快捷键使用非原生全屏，覆盖刘海两侧；窗口留在当前 Space，刘海可能遮挡内容，原生标签页不可用。
fullscreen = non-native
macos-non-native-fullscreen = true
# 给顶部摄像头和状态栏下方的内容留出空间。
window-padding-y = 20,4
# 主配置开了 padding-balance，它会把网格上下居中，顶部给刘海留的 20pt 就被镜像到底部，
# 底部平白空出一截。macOS 上关掉，多出来的零头只留在底部。
window-padding-balance = false

# ===== 毛玻璃：静态壁纸图代替实时模糊 =====
# 窗口不透明，背景铺一张预先模糊好的当前壁纸截图（backgrounds/make.sh 生成，不进 git）。
# 全屏和窗口模式看起来一致，也省掉实时模糊的合成开销；换壁纸要重跑脚本。
background-opacity = 1
background-image = backgrounds/wallpaper.png
# 图和主题背景色按 0.45 : 0.55 混合，让壁纸更清楚，同时保留文字可读性。
background-image-opacity = 0.45
background-image-fit = cover
background-image-position = center
# Ctrl+Enter 在 macOS 上默认没绑定，补上，和 Linux 同一个键；Cmd+Enter 仍然可用
keybind = ctrl+enter=toggle_fullscreen

# ===== 用全屏窗口代替标签页 =====
# 非原生全屏下没有原生标签页，Cmd+T 只会弹 "Cannot Create New Tab"，改成开新窗口。fullscreen = non-native 让新窗口
# 也进全屏，但从全屏窗口里开的新窗口位置算错：顶部空出菜单栏那么高一条（Ghostty 1.4）。在按键上串 toggle_fullscreen
# 没用，串联的动作落在旧窗口上，会把旧窗口切成小窗；所以由新窗口里的 zsh 启动时调 bin/ghostty-refullscreen，
# 对这个窗口自己退出再进入一次全屏（等于手按两次 Cmd+Enter）。
# 全屏窗口叠在一起用起来就像标签页，每个窗口可以连不同的机器（sshx 主机）。
# Cmd+Shift+←/→ 前后切换，和 iPad 上 WebMosh 切标签同一个键；Cmd+W 关掉当前这个
keybind = super+t=new_window
keybind = super+shift+arrow_left=goto_window:previous
keybind = super+shift+arrow_right=goto_window:next

# ===== 把 Option+←/→ 原样交给 tmux =====
# Ghostty 在 macOS 上默认把 Option+←/→ 改写成 Esc b / Esc f（按词移动），
# tmux 收到的是 M-b / M-f 而不是 M-Left / M-Right，Alt+←/→ 切窗口就失效了。
# 解绑后它们和 Linux 一样送出 \e[1;3D / \e[1;3C；tmux 外的按词移动由 zshrc 单独绑这两个序列。
keybind = alt+arrow_left=unbind
keybind = alt+arrow_right=unbind
