# Theme: snappy_light
# 和 Ghostty 的 themes/snappy_light 同一套色：正文 #202533，暗淡 #98A1B5，强调蓝 #2B7FD6
# main_bg 留空 = 用终端自己的背景（半透明毛玻璃透出来）

theme[main_bg]=""
theme[main_fg]="#202533"
theme[title]="#202533"
theme[hi_fg]="#2B7FD6"
theme[selected_bg]="#D9E4F5"
theme[selected_fg]="#202533"
theme[inactive_fg]="#98A1B5"
theme[graph_text]="#98A1B5"
theme[meter_bg]="#DCD6CB"
theme[proc_misc]="#2F98AB"

theme[cpu_box]="#98A1B5"
theme[mem_box]="#98A1B5"
theme[net_box]="#98A1B5"
theme[proc_box]="#98A1B5"
theme[div_line]="#C4C9D4"

theme[temp_start]="#4F956C"
