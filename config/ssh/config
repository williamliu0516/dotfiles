# 共用的 ssh 设置，软链到 ~/.ssh/config（modules/git-ssh）。密钥和自己机器的主机别名都不进仓库：
# 写在 ~/.ssh/config.local，它在最前面 Include，同一项以它为准。
Include ~/.ssh/config.local

Host github.com
  HostName github.com
  User git
  # 两个名字都列上，ssh 按顺序挨个试：有的机器叫 id_ed25519_github，有的直接用 id_ed25519。
  # 本机还有别的名字就写进 ~/.ssh/config.local（它先被 Include，会排在最前面先试）
  IdentityFile ~/.ssh/id_ed25519_github
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
