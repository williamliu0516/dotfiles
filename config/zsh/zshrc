# ===== powerlevel10k instant prompt（必须放最顶部）=====
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# 固定指向自己的配置目录，不跟 $ZDOTDIR 走：robo shell 等工具会把 ZDOTDIR
# 改成它们自己的（还是相对路径）再 source 这个文件，跟着走就找不到插件
ZCONF="${XDG_CONFIG_HOME:-$HOME/.config}/zsh"
ZPLUG="$ZCONF/plugins"

# ===== PATH（typeset -U 自动去重）=====
typeset -U path PATH
path=("$HOME/.local/bin" $path)

export EDITOR=nvim
command -v nvim >/dev/null || export EDITOR=vim

# ===== 历史 =====
HISTFILE="$ZCONF/.zsh_history"
HISTSIZE=1000000
SAVEHIST=1000000
unsetopt SHARE_HISTORY        # 不把别的 pane 的命令串进当前 pane
setopt APPEND_HISTORY
setopt INC_APPEND_HISTORY     # 敲一条写一条，不等 shell 退出
setopt HIST_FCNTL_LOCK        # 文件锁，并发 shell 不互相覆盖
setopt HIST_SAVE_NO_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_REDUCE_BLANKS
setopt EXTENDED_HISTORY

setopt AUTO_CD                # 直接敲目录名就能进去
setopt INTERACTIVE_COMMENTS

# ===== 命名目录：cd ~cf 进 ~/.config，提示符也会反向缩写 =====
hash -d cf=$HOME/.config
hash -d dl=$HOME/Downloads
hash -d doc=$HOME/Documents
hash -d sc=$HOME/.local/bin

# ===== 补全 =====
autoload -Uz compinit
compinit -d "$ZCONF/.zcompdump" -C
zmodload zsh/complist
# 不加 globdots：补全默认不列隐藏文件，敲了开头的 . 再 Tab 才列
zstyle ':completion:*' matcher-list '' 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*'
zstyle ':completion:*' menu no          # 菜单交给 fzf-tab
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*:descriptions' format '[%d]'

# ===== fzf-tab：Tab 补全菜单换成 fzf，任何补全都能模糊筛 =====
# 必须在 compinit 之后、autosuggestions / syntax-highlighting 之前加载
if [[ -r "$ZPLUG/fzf-tab/fzf-tab.plugin.zsh" ]]; then
  source "$ZPLUG/fzf-tab/fzf-tab.plugin.zsh"
  zstyle ':fzf-tab:*' fzf-flags --height=50% --border=rounded   # 和 FZF_DEFAULT_OPTS 的配色一致
  zstyle ':fzf-tab:*' switch-group '<' '>'                      # 多组候选（文件 / 选项）用 < > 切
  zstyle ':fzf-tab:*' continuous-trigger '/'                     # 补目录时敲 / 直接进下一层继续补
  # 预览：目录看一层内容，文件看开头
  zstyle ':fzf-tab:complete:(cd|z|ls|eza|cat|bat|nvim|vim|code):*' fzf-preview \
    '[[ -d $realpath ]] && eza -1 --color=always --icons=always $realpath || bat --color=always --style=plain --line-range=:80 $realpath 2>/dev/null'
  zstyle ':fzf-tab:complete:git-(checkout|switch|merge|rebase):*' fzf-preview 'git log --oneline -8 --color=always $word 2>/dev/null'
fi

# ===== 插件 =====
# 自动建议的灰字颜色：明显暗于正文，一眼看出是建议而非已输入
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#4a5169'
source "$ZPLUG/zsh-autosuggestions/zsh-autosuggestions.zsh"
source "$ZPLUG/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh"
source "$ZPLUG/zsh-history-substring-search/zsh-history-substring-search.zsh"

# 上下箭头：按已输入的前缀筛历史
HISTORY_SUBSTRING_SEARCH_ENSURE_UNIQUE=1
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
bindkey '^[OA' history-substring-search-up
bindkey '^[OB' history-substring-search-down

bindkey '^[[1;5C' forward-word         # Ctrl+→
bindkey '^[[1;5D' backward-word        # Ctrl+←
# macOS：Ctrl+←/→ 被系统的 Mission Control（切换 Space）抢走，用 Option+←/→ 按词移动。
# macos.ghostty 解绑了 Ghostty 自带的 Option+←/→ → Esc b/f，所以这里收到的是原始序列；
# tmux 里这两个键被 tmux 拿去切窗口（和 Linux 的 Alt+←/→ 一样），只在 tmux 外生效。
bindkey '^[[1;3C' forward-word         # Option+→（macOS）/ Alt+→（Linux，tmux 外）
bindkey '^[[1;3D' backward-word        # Option+←
bindkey '^H'  backward-kill-word       # Ctrl+Backspace
bindkey '^[[3~' delete-char

# ===== fzf：Ctrl+R 模糊搜历史，Ctrl+T 选文件，Alt+C 跳目录（tmux 外）=====
# Ubuntu 上 fd 叫 fdfind、bat 叫 batcat；预览命令在子 shell 里跑，别名不生效，所以用变量
_FD=fd;   command -v fd  >/dev/null || { command -v fdfind >/dev/null && _FD=fdfind; }
_BAT=bat; command -v bat >/dev/null || { command -v batcat >/dev/null && _BAT=batcat; }
command -v fdfind >/dev/null && ! command -v fd >/dev/null && alias fd=fdfind
if command -v fzf >/dev/null; then
  export FZF_DEFAULT_OPTS="--reverse --height=40% --border=rounded \
    --color=bg+:#283457,fg+:#c0caf5,hl:#7aa2f7,hl+:#7dcfff,prompt:#7aa2f7,pointer:#bb9af7,info:#565f89"
  # 用 fd 列文件：快，跟随 .gitignore。默认不含隐藏文件，fzf 里按 Ctrl+H 切换成包含
  _FZF_HIDDEN_TOGGLE=""
  if command -v "$_FD" >/dev/null; then
    export FZF_DEFAULT_COMMAND="$_FD --type f --follow --exclude .git"
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND="$_FD --type d --follow --exclude .git"
    _FZF_HIDDEN_TOGGLE="--bind 'ctrl-h:change-prompt(含隐藏 › )+reload($_FD --type f --hidden --follow --exclude .git)'"
    _FZF_HIDDEN_TOGGLE_DIR="--bind 'ctrl-h:change-prompt(含隐藏 › )+reload($_FD --type d --hidden --follow --exclude .git)'"
  fi
  # 右侧预览：文件用 bat 看前 200 行，目录用 eza 看一层；历史只显示命令，不显示序号
  export FZF_CTRL_T_OPTS="--preview '$_BAT --color=always --style=numbers --line-range=:200 {} 2>/dev/null || ls -la {}' --preview-window=right:55% $_FZF_HIDDEN_TOGGLE"
  export FZF_ALT_C_OPTS="--preview 'eza --tree --level=1 --color=always --icons=always {} 2>/dev/null || ls {}' ${_FZF_HIDDEN_TOGGLE_DIR:-}"
  export FZF_CTRL_R_OPTS="--with-nth=2.. --preview 'echo {2..}' --preview-window=down:3:wrap"
  if fzf --zsh >/dev/null 2>&1; then
    source <(fzf --zsh)
  else
    [ -f /usr/share/doc/fzf/examples/key-bindings.zsh ] && source /usr/share/doc/fzf/examples/key-bindings.zsh
    [ -f /usr/share/doc/fzf/examples/completion.zsh ] && source /usr/share/doc/fzf/examples/completion.zsh
  fi
fi

# ===== → 接受灰字建议，Tab 保持正常补全 =====
bindkey '^[[C' forward-char             # → ：在 autosuggestions 的接受列表里
bindkey '^[OC' forward-char
bindkey '^[[Z' reverse-menu-complete    # Shift+Tab 反向选菜单

# ===== yazi：y 打开文件管理器，退出时 shell 跟着进到最后停留的目录 =====
if command -v yazi >/dev/null; then
  y() {
    local tmp; tmp="$(mktemp -t yazi-cwd.XXXXXX)"
    yazi "$@" --cwd-file="$tmp"
    local cwd; IFS= read -r -d '' cwd < "$tmp" 2>/dev/null
    [[ -n "$cwd" && "$cwd" != "$PWD" ]] && builtin cd -- "$cwd"
    rm -f -- "$tmp"
  }
fi

# ===== zoxide：z 按访问频率跳转 =====
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"

# ===== 别名 =====
if command -v eza >/dev/null; then
  alias ls='eza --icons=always --group-directories-first'
  alias ll='eza --long --git --icons=always --group-directories-first --sort=modified --reverse'
  alias la='eza --long --all --git --icons=always --group-directories-first'
  alias lt='eza --tree --level=2 --icons=always'
else
  [[ $OSTYPE == darwin* ]] && alias ls='ls -G' || alias ls='ls --color=auto'
  alias ll='ls -alF'
  alias la='ls -A'
fi
# Ubuntu 上 bat 叫 batcat，macOS（brew）上就叫 bat
if command -v batcat >/dev/null; then
  alias bat='batcat' cat='batcat --paging=never'
elif command -v bat >/dev/null; then
  alias cat='bat --paging=never'
fi
alias l='ls'
alias grep='grep --color=auto'
alias diff='diff --color=auto'
alias cp='cp -iv'
alias mv='mv -i'
alias mkd='mkdir -pv'
[[ $OSTYPE == darwin* ]] && alias o='open' || alias o='xdg-open'
alias cf='cd ~/.config && ls'
alias ..='cd ..'
alias ...='cd ../..'
alias gs='git status'
alias gd='git diff'
alias gl='git log --oneline --graph --decorate -20'
alias tk='tmux kill-server'

# ===== micromamba =====
export MAMBA_EXE="$HOME/.local/bin/micromamba"
export MAMBA_ROOT_PREFIX="$HOME/micromamba"
if [ -x "$MAMBA_EXE" ]; then
  __mamba_setup="$("$MAMBA_EXE" shell hook --shell zsh --root-prefix "$MAMBA_ROOT_PREFIX" 2>/dev/null)"
  if [ $? -eq 0 ]; then eval "$__mamba_setup"; else alias micromamba="$MAMBA_EXE"; fi
  unset __mamba_setup
fi

# ===== 提示符 =====
source "$ZPLUG/powerlevel10k/powerlevel10k.zsh-theme"
[[ -f "$ZCONF/.p10k.zsh" ]] && source "$ZCONF/.p10k.zsh"

# ===== 速查表：Alt+/（Mac 上 Option+/）随时弹出，tmux 里用浮层，tmux 外用 less，q 关闭 =====
cheat() {
  if [[ -n $TMUX ]]; then tmux display-popup -w 80% -h 90% -E "$HOME/.local/bin/tmux/cheatsheet.sh"
  else "$HOME/.local/bin/tmux/cheatsheet.sh" --no-wait | less -R; fi
}
_cheat_widget() { zle -I; cheat </dev/tty; zle reset-prompt; }
zle -N _cheat_widget
bindkey '^[/' _cheat_widget

# ===== 长命令结束通知：超过 30 秒的命令跑完时，如果你没在看这个终端就弹一条 =====
# 交互式程序（编辑器、分页器、tmux、ssh…）本来就要人盯着，不算
NOTIFY_AFTER=30
NOTIFY_IGNORE='^(vim?|nvim|nano|less|more|man|tmux|ssh|mosh|top|htop|btop|yazi|lazygit|claude|fzf|python3?|node|irb|git (log|diff|show|commit|rebase)|y|z|cd|ls)( |$)'
_notify_preexec() { _notify_cmd=$1; _notify_t0=$EPOCHSECONDS; }
_notify_precmd() {
  local rc=$? t0=${_notify_t0:-} cmd=${_notify_cmd:-}
  _notify_t0=; _notify_cmd=
  [[ -z $t0 ]] && return
  local dt=$(( EPOCHSECONDS - t0 ))
  (( dt < NOTIFY_AFTER )) && return
  [[ $cmd =~ $NOTIFY_IGNORE ]] && return
  local title="命令完成（${dt}s）"; (( rc != 0 )) && title="命令失败（退出码 $rc，${dt}s）"
  "$HOME/.local/bin/notify" --if-away "$title" "${cmd:0:80}" &!
}
if [[ -x "$HOME/.local/bin/notify" ]]; then
  zmodload zsh/datetime
  autoload -Uz add-zsh-hook
  add-zsh-hook preexec _notify_preexec
  add-zsh-hook precmd  _notify_precmd
fi

# ===== 本机专属（不进仓库）=====
# ZDOTDIR 指向 ~/.config/zsh 之后 ~/.zshrc 不再被读取；机器专属的 PATH、密钥等放这个文件
[[ -f "$ZCONF/local.zsh" ]] && source "$ZCONF/local.zsh"
