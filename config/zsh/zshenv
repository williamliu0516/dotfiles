# 每个 zsh 都读的环境（含非交互的：ssh 远程命令、mosh-server 启动、scp、cron）。
# .zshrc 只在交互 shell 里读，所以 Blink / mosh 通过 `ssh host mosh-server new` 启动服务端时
# PATH 里没有 Homebrew，会报 "mosh-server: command not found"；这里把 PATH 和 UTF-8 locale 补上。
# 由 ~/.zshenv 在设完 ZDOTDIR 之后 source（zsh 不会自己读 $ZDOTDIR/.zshenv）
typeset -U path
for d in /opt/homebrew/bin /opt/homebrew/sbin /usr/local/bin /home/linuxbrew/.linuxbrew/bin "$HOME/.local/bin"; do
  [ -d "$d" ] && path=("$d" $path)
done
# Linux 上 CLI 工具由 Nix + Home Manager 提供（nix/home.nix）。Nix 安装器只改 /etc/zsh/zshrc（交互 shell），
# 这里补上，让 ssh 远程命令和脚本也能找到它们。hm-session-vars.sh 里是 Home Manager 的环境变量
# （XDG 路径、它自己加的 PATH），源一次就够；HM 用 __HM_SESS_VARS_SOURCED 防重复。
if [ -r "$HOME/.nix-profile/etc/profile.d/hm-session-vars.sh" ]; then
  . "$HOME/.nix-profile/etc/profile.d/hm-session-vars.sh"
fi
for d in /nix/var/nix/profiles/default/bin "$HOME/.nix-profile/bin"; do
  [ -d "$d" ] && path=("$d" $path)
done
# mosh-server 必须有 UTF-8 locale，客户端没带 LANG 过来时给个默认值
if [ -z "${LANG:-}" ] && [ -z "${LC_ALL:-}" ]; then
  export LANG=en_US.UTF-8
fi
# mosh-server 兜底：iPad 关掉窗口后 mosh-server 会一直等客户端回来，不会自己退出。
# NETWORK_TMOUT：一周没联系自动退出。SIGNAL_TMOUT：收到 SIGUSR1 时，60 秒内有联系的不杀，
# 于是 `pkill -USR1 -x mosh-server` 只清闲置的、保住正在用的那条（homeboard 的会话卡也用同样的判断）。
# 只对之后新启动的 mosh-server 生效。
export MOSH_SERVER_NETWORK_TMOUT=604800
export MOSH_SERVER_SIGNAL_TMOUT=60
